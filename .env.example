# KALAA Backend Environment Configuration
SECRET_KEY=<your-secret-key-here>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://user:password@localhost/kalaa
# Or for development:
# DATABASE_URL=sqlite:///./kalaamvp.db

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI Services (set AI_PROVIDER=openai and provide keys for real AI)
AI_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Blockchain (set BLOCKCHAIN_PROVIDER=web3 and provide RPC_URL/PRIVATE_KEY)
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=testnet
RPC_URL=https://rpc.ankr.com/eth_goerli
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=5

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
IPFS_GATEWAY=https://ipfs.io

# Platform Fee
PLATFORM_FEE_PERCENT=5.0
B2B_FEE_PERCENT=3.0
SECONDARY_SALE_FEE_PERCENT=2.0

# Admin credentials (change after first login)
ADMIN_EMAIL=admin@kalaamarket.com
ADMIN_PASSWORD=change-this-password

# Environment
ENVIRONMENT=production
DEBUG=false

# Security
MAX_UPLOAD_SIZE=5242880
RATE_LIMIT_PER_MINUTE=60
