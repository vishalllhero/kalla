# KALAA Environment Configuration
# Never store real secrets or credentials in this file.
# Use local environment variables or a gitignored .env file instead.

# Frontend: use /api when frontend and backend share a Vercel Services domain.
# Otherwise set the deployed backend URL, for example https://api.example.com.
VITE_API_URL=REQUIRED_FROM_USER

# Backend
SECRET_KEY=REQUIRED_FROM_USER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=REQUIRED_FROM_USER
# Or for development:
# DATABASE_URL=sqlite:///./kalaamvp.db

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL
FRONTEND_URL=REQUIRED_FROM_USER
# Comma-separated production/preview origins, without a trailing slash.
CORS_ORIGINS=REQUIRED_FROM_USER

# AI Services (set AI_PROVIDER=openai and provide keys for real AI)
AI_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Blockchain (Solana mock mode does not require an RPC URL or chain ID)
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=solana
# For a future configured provider, use BLOCKCHAIN_PROVIDER=solana and a devnet network.
# BLOCKCHAIN_NETWORK=solana-devnet
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
IPFS_GATEWAY=https://ipfs.io

# Platform Fee
PLATFORM_FEE_PERCENT=5.0
B2B_FEE_PERCENT=3.0
SECONDARY_SALE_FEE_PERCENT=2.0

# Optional demo/seed credentials. Required only when running seed_data.py.
ADMIN_EMAIL=REQUIRED_FROM_USER
ADMIN_PASSWORD=REQUIRED_FROM_USER
ARTISAN_PASSWORD=REQUIRED_FROM_USER
BUYER_PASSWORD=REQUIRED_FROM_USER

# Environment
ENVIRONMENT=production
DEBUG=false

# Security
MAX_UPLOAD_SIZE=5242880
RATE_LIMIT_PER_MINUTE=60
